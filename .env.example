# Copy to an ignored local environment file. Keep credentials process-scoped; never commit them.
GENLAYER_NETWORK=localnet
NEXT_PUBLIC_GENLAYER_NETWORK=localnet
NEXT_PUBLIC_ACCESSSEAL_CONTRACT_ADDRESS=
NEXT_PUBLIC_EXPLORER_BASE_URL=

# Test-only local build switch. Use only process-scoped values with the explicit test address.
NEXT_PUBLIC_ACCESSSEAL_SAFE_TEST_CONFIG=

# Optional live settlement proof gate. Keep disabled for local GLSim.
# Localnet and Bradbury GEN are simulated testnet value.
ACCESSSEAL_LIVE_SETTLEMENT=
ACCESSSEAL_SETTLEMENT_PROOF_PATH=
ACCESSSEAL_LIVE_RPC_URL=
ACCESSSEAL_LIVE_NETWORK=studionet
ACCESSSEAL_LIVE_CHAIN_ID=61999
ACCESSSEAL_LIVE_CONTRACT_ADDRESS=
ACCESSSEAL_LIVE_CASE_ID=
ACCESSSEAL_LIVE_SETTLEMENT_ID=
ACCESSSEAL_LIVE_RECIPIENT=
ACCESSSEAL_LIVE_AMOUNT=
